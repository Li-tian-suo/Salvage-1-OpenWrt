#!/bin/sh
# /etc/init.d/hk09-wifiguard
#
# 目的：本板实测会在高负载（如 homebox 跑测速）之后"Wi-Fi 整体消失"——
#   系统还活着（ping / :80 / :22 / :3300 全通），但 `iw dev` 里一个接口都没有，
#   Windows 也完全扫不到 SSID。
#   这种状态不会自愈：ath11k 的 phy 已经没了，必须重新加载无线。
#
# 本守护进程做三件事：
#   1. 每 20 秒检查 `iw dev` 是否还有预期数量的接口
#   2. 少了就先 `wifi reload`（轻量，不影响已连接客户端）
#   3. 再不行就 `wifi down; wifi up`（重）；
#      连续 N 次失败，记一条 error 日志，让用户知道要手动处理
#
# 注意：故意**不**自动重启整机。
#   - 重启会把所有有线连接也断掉，代价远大于收益
#   - 崩溃现场会被冲掉，反而不利于排查
#   真要整机重启，请自行装 luci-app-watchcat 或加 cron reboot。

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/hk09-wifiguard

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	# 崩了就重启；respawn 阈值设宽松些，避免它自己刷屏
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
