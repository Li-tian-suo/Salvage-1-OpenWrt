#
# HK09 完整配置（full profile）
#
# 设备：ccmx200/Salvage-1 同款 IPQ8072A 板子，board_name = hk09,hk09
#
# 这是一份「配置碎片」，只写关键项，其余交给 `make defconfig` 补默认值。
#
# ⚠️ Kconfig 不支持行尾注释！
#    写成 CONFIG_PACKAGE_xxx=y   # 说明   会被整行忽略。
#    注释必须独占一行。
#
# 包名的可靠性：下面每个 CONFIG_PACKAGE_ 都对照过 fork 源码树里
# package/kernel/linux/modules/*.mk 的 KernelPackage 定义（共 1049 个 kmod），
# 以及 feeds 里的普通包。写错会被 defconfig 静默丢弃，
# workflow 的「自定义包落地检查」会标 DROPPED —— 看到就去查依赖。
#

# ============================================================
# 一、目标平台与设备（这三行是核心，缺一个就编不出固件）
# ============================================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
# 【符号形式】设备选择在 .config 里是
#     CONFIG_TARGET_<target>_<subtarget>_DEVICE_<vendor>_<model>
# 而**不是** CONFIG_TARGET_DEVICE_<target>_<subtarget>_DEVICE_...
#
# 依据：tmp/.config-target.in 里同时存在两个符号
#     config     TARGET_qualcommax_ipq807x_DEVICE_hk09_hk09        <- 写进 .config 的是这个
#     menuconfig TARGET_qualcommax_ipq807x_DEVICE_hk09_hk09  <- menuconfig 界面用的
# 对照已选中设备：CONFIG_TARGET_qualcommax_ipq807x_DEVICE_aliyun_ap8220=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_hk09_hk09=y

# ============================================================
# 二、根文件系统
# ============================================================
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP=y
# NAND 全盘 256 MiB，rootfs 给 256 MiB（实机会按 UBI 自动收缩）
CONFIG_TARGET_ROOTFS_PARTSIZE=256
CONFIG_TARGET_ROOTFS_UBIFS=y

# ============================================================
# 三、基础系统
# ============================================================
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
# 主题：Argon 做默认，bootstrap 保留兜底。
#
# 为什么两个都要：
#   - 万一 argon 的 js/css 有问题，还能在 LuCI 里切回 bootstrap
#   - 多占约 1.5 MB，对 29 MB 的固件无所谓
#
# 关于依赖（实测确认，不要凭印象加）：
#   读 feeds/luci/themes/luci-theme-argon/Makefile 得到
#       LUCI_DEPENDS := +wget-any +jsonfilter
#   主题里 .lua 文件 0 个、.uc 文件 0 个 —— 是纯 JS/CSS，**不需要 luci-compat**。
#   wget-any 是虚拟名，由 uclient 或 wget(-ssl) 提供，本配置已选 wget-ssl。
#   （先前注释写"argon 需要 luci-compat"是错的，已改正。）
#
# 注意：argon 装了之后要在 LuCI → 系统 → 系统 → 语言和界面 → 设计 里
# 选一下才生效；也可以直接 uci set luci.main.mediaurlbase 固化。
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
# argon 的配置页面（可调主色、深色模式、背景图等），不带它只有默认样式
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-firewall=y
# 注意：没有 luci-app-opkg 这个包（新版已改名为 luci-app-package-manager）
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-3g=y

# ---- Web 服务器（缺了它 LuCI 打不开！）----
# luci 基础包 **不会** 自动拉 uhttpd —— 前端和后端是分开的包。
# 漏掉这几个的话，刷进去网页直接打不开，只能靠串口。
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y      # LuCI 的 rpcd/ubus 后端要走这个
CONFIG_PACKAGE_uhttpd-mod-ucode=y     # 新版 LuCI 前端是 ucode 写的
CONFIG_PACKAGE_libustream-openssl=y   # uhttpd 的 TLS 支持依赖它
CONFIG_PACKAGE_rpcd=y                 # LuCI 的一切 RPC 都过它
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y

CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iptables-nft=y

# ---- 防火墙后端（必须显式选！）----
# luci-app-firewall 的 DEPENDS 只有 +luci-base +uci-firewall，
# uci-firewall 只是配置读写库，**不含** fw4 后端。
# 漏了 firewall4 的话，LuCI 能打开防火墙页面，但保存规则会失败
# （/sbin/fw4 不存在）。另外 NAT offload 也依赖它。
CONFIG_PACKAGE_firewall4=y
# 注意：**没有**叫「nftables」的包。nft 命令由 nftables-json 提供
# （package/network/utils/nftables/Makefile 里 PKG_NAME:=nftables 但
#  导出的是 nftables-json / nftables-nojson，PROVIDES 才是 nftables）。
# firewall4 的 DEPENDS 已经 +nftables-json，会自动带入，无需手写。
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-offload=y       # 硬件 NAT offload 要用
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-ipt-offload=y

# NAND / UBI 管理工具：备份和刷机都要用，别省
# 注意：**没有**叫「mtd-utils」的包。package/utils/mtd-utils/Makefile 里
# 实际导出的是 nand-utils 和 ubi-utils；裸 mtd 工具在 package/system/mtd。
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y
# uboot-envtools 提供 fw_printenv / fw_setenv，用来读写 U-Boot 环境变量。
# 注意：它和 tools/mkimage 共用同一份 u-boot 源码包
# （都是 u-boot-2025.10.tar.bz2，哈希 b4f032848...）。
# 而 mkimage 是生成 FIT 镜像的 host 工具，绕不过去，
# 所以源码包无论如何都要下载 —— 那就没有理由省掉这个有用的工具。
CONFIG_PACKAGE_uboot-envtools=y

# ============================================================
# 四、Wi-Fi（ath11k AHB，IPQ8074 hw2.0）
# ============================================================
CONFIG_PACKAGE_ath11k-firmware-ipq8074=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wifi-scripts=y

# ============================================================
# 五、有线 / NSS 硬件加速
# ============================================================
# 这些包全部来自 feeds/nss_packages（不在 package/ 下，必须先 feeds update -a），
# 而且**全部是 KernelPackage/**，所以 .config 里要写 kmod- 前缀：
#
#   feeds/nss_packages/qca-nss-drv/Makefile:  define KernelPackage/qca-nss-drv
#     -> CONFIG_PACKAGE_kmod-qca-nss-drv=y     （注意 kmod- 前缀！）
#
# 我最初漏了 kmod- 前缀，也以为这些包不存在 —— 两个错误都源于
# 只搜 package/ 目录、且没区分 Package/ 与 KernelPackage/ 的符号规则。
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-mcs=y
# 客户端功能模块（按需增减）
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
# 注意：**没有** kmod-qca-nss-drv-profile 可选。
# 它的 DEPENDS 里写了 `@TARGET_ipq806x`，只支持 IPQ806x，本板是 IPQ807x，
# defconfig 会直接丢弃。这是上游设计如此，不是配置错误。
# 用户态工具：nss-userspace-oss/Makefile 实际导出 libnl-nss 和 nssinfo，
# **没有**叫 nss-userspace 的包。
CONFIG_PACKAGE_nssinfo=y
CONFIG_PACKAGE_libnl-nss=y
# NSS 版本的 SQM
CONFIG_PACKAGE_sqm-scripts-nss=y

# ============================================================
# 六、homebox 内网测速（二进制随包提供，见 local-packages/homebox）
# ============================================================
CONFIG_PACKAGE_homebox=y

# ============================================================
# 七、USB 基础（板上有 usb_0 / usb_1 两个控制器，DTS 已 okay）
# ============================================================
# usb_0 = USB2，usb_1 = USB3（DWC3 + QUSB2/SS PHY）
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-roles=y
CONFIG_PACKAGE_kmod-usb-common=y
# 注意：kmod-usb-lib-composite 的 Makefile 里写着 HIDDEN:=1，
# 它是给 gadget 类包当自动依赖用的，不该手动选（选了也会被 kconfig 忽略）。
# 需要 composite 时选具体的 gadget 包（如 kmod-usb-gadget-eth），它会自动带上。

# USB 存储：U 盘 / 移动硬盘
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-scsi-core=y

# USB HID / 其它
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_libusb-1.0=y
CONFIG_PACKAGE_usbids=y

# ============================================================
# 八、USB 串口（调试/模组/单片机都用）
# ============================================================
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-ch348=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-serial-simple=y
CONFIG_PACKAGE_kmod-usb-wdm=y

# ============================================================
# 九、USB 有线网卡（常用芯片全覆盖）
# ============================================================
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-aqc111=y
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y
CONFIG_PACKAGE_kmod-usb-net-lan78xx=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y

# ============================================================
# 十、文件系统（U 盘 / NAS 常用格式）
# ============================================================
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_kmod-fs-cifs=y
CONFIG_PACKAGE_kmod-fs-nfs=y
CONFIG_PACKAGE_kmod-fs-isofs=y
CONFIG_PACKAGE_kmod-fs-udf=y
CONFIG_PACKAGE_kmod-fuse=y

# NLS：中文文件名必须，否则 U 盘上的中文会乱码
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y

CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_f2fs-tools=y

# ============================================================
# 十一、USB 文件共享（ksmbd，体积比 samba4 小很多）
# ============================================================
CONFIG_PACKAGE_kmod-fs-ksmbd=y
# feeds/packages/net/ksmbd-tools/Makefile 实际只导出三个包：
#     ksmbd-server            （主服务）
#     ksmbd-hotplug
#     ksmbd-avahi-service     （需要 avahi，体积大，不必）
# 没有叫 ksmbd-tools / ksmbd-utils 的包。
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_ksmbd-hotplug=y
CONFIG_PACKAGE_luci-app-ksmbd=y

# 文件系统**用户态工具**（内核侧 kmod-fs-* 已在「十、文件系统」段落选好，
# 这里只补用户态，避免重复声明）。
# 来源：
#   exfat-mkfs / exfat-fsck   <- feeds/packages/utils/exfatprogs/Makefile
#   mkf2fs / f2fsck           <- package/utils/f2fs-tools/Makefile
#   ntfs-3g                   <- feeds/packages/utils/ntfs-3g（FUSE 版，兼容最好）
#   fuse-utils / fuse3-utils  <- feeds/packages/utils/fuse{,3}/Makefile
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_libudev-zero=y
CONFIG_PACKAGE_fuse-utils=y
CONFIG_PACKAGE_fuse3-utils=y
CONFIG_PACKAGE_libfuse3=y
# USB 网卡补全（参考 PonWRT 的 full 档位）
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=y

# ============================================================
# 十一之二、代理 / 透明网关（OpenClash）
# ============================================================
# OpenClash 不在官方 feed 里，由 diy-part1.sh 引入第三方 feed
# （vernesong/OpenClash，commit 锁定 e553e82）。
#
# 它的 DEPENDS（读 luci-app-openclash/Makefile 得到）：
#   +dnsmasq-full +bash +curl +ca-bundle +ip-full
#   +ruby +ruby-yaml +kmod-tun +unzip
# 已在别处选好的依赖不再重复声明：
#   dnsmasq-full / ip-full  -> 「三、基础系统」
#   bash / curl / ca-bundle -> 「十三、常用工具」
#   kmod-tun                -> 「十二、网络工具与隧道」
# 这里只补 openclash 独有、别处没有的：
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_luci-app-openclash=y
# 透明代理模式（TPROXY）需要这两个；OpenClash 官方文档要求
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ipset=y
# OpenClash 是 lua 写的 LuCI 应用（luasrc/），必须带 lua 兼容层，
# 否则「服务 -> OpenClash」页面 500。这点与 argon 主题不同（argon 是纯 JS）。
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_luci-lua-runtime=y

# ============================================================
# 十二、网络工具与隧道
# ============================================================
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_kmod-gre=y
CONFIG_PACKAGE_kmod-sit=y
CONFIG_PACKAGE_kmod-ipip=y
CONFIG_PACKAGE_kmod-wireguard=y

# NAT 加速 / 流卸载
# kmod-ipt-offload / kmod-nft-offload / kmod-nf-flow 已在「防火墙后端」段落
# （约第 107 行）声明过，这里不重复，只补其余几个。
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y

# SQM（限速/抗缓冲膨胀）
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y

# ============================================================
# 十三、常用工具
# ============================================================
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ncdu=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-filemanager=y

# 调试用：dmidecode 之类没有，但 devmem/kallsyms 很重要
CONFIG_PACKAGE_kmod-ikconfig=y
CONFIG_KERNEL_IKCONFIG=y
CONFIG_KERNEL_IKCONFIG_PROC=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y

# ============================================================
# 十四、自定义本地包
# ============================================================
CONFIG_PACKAGE_hello-hk09=y
